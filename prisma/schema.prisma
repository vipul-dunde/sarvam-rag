generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Topics {
  id          Int    @id @default(autoincrement())
  fileName    String @db.Text
  Description String @db.Text
}

model TopicsGoogle {
  id          Int    @id @default(autoincrement())
  fileName    String @db.Text
  Description String @db.Text
}

model TopicsOpenAI {
  id          Int    @id @default(autoincrement())
  fileName    String @db.Text
  Description String @db.Text
}
